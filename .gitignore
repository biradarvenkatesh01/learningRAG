# ==========================================
# Root .gitignore (learningRAG)
# ==========================================

# ---------- Secrets & Environment ----------
.env
.env.*
.env.local
.env.*.local
!.env.example
!frontend/.env.development
*.pem
*.key
*.cert

# ---------- Python (Backend) ----------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local databases & uploads
backend/uploads/
backend/chroma_db/
backend/model/
uploads/
chroma_db/
*.sqlite
*.sqlite3
*.db

# ---------- Node / Frontend ----------
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
*.local
.vite/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Vercel ----------
.vercel/

# ---------- Editors, Tools & OS ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
