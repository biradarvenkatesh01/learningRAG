pnpm-debug.log*
lerna-debug.log*

# Environment & secrets
.env
.env.local
.env.*.local
!.env.example
!.env.development

# Vercel
.vercel/

# Editor & OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
