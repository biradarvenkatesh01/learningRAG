# ==========================================
# Python Backend .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Local storage, uploads & vector databases
uploads/
chroma_db/
*.sqlite
*.sqlite3
*.db

# Vercel deployment cache
.vercel/

# Editor & OS files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
