# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Upstash Vector: create an index with Embedding Model = Custom, Dimensions = 384, Metric = COSINE
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Documents are deleted when the chat session ends; leftovers are removed after this many hours
SESSION_TTL_HOURS=2

# Any long random string. Vercel Cron sends it to /cleanup (daily sweep of abandoned sessions)
CRON_SECRET=
